#include<stdio.h>
#include<string.h>

int main()
{
    char s[100];
    int i,f=1,n;

    gets(s);

    n=strlen(s);

    for(i=0;i<n/2;i++)
    {
        if(s[i]!=s[n-1-i])
        {
            f=0;
            break;
        }
    }

    if(f)
        printf("Palindrome");
    else
        printf("Not Palindrome");

    return 0;
}
