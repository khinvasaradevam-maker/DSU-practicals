#include<stdio.h>

int main()
{
    char a[100],b[100];
    int i=0,f=1;

    gets(a);
    gets(b);

    while(a[i]!='\0'||b[i]!='\0')
    {
        if(a[i]!=b[i])
        {
            f=0;
            break;
        }
        i++;
    }

    if(f)
        printf("Equal");
    else
        printf("Not Equal");

    return 0;
}
