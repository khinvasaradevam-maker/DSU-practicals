#include<stdio.h>
#include<string.h>

int main()
{
    char a[100],b[100],*p;

    printf("Enter first string: ");
    gets(a);

    printf("Enter second string: ");
    gets(b);

    printf("Length = %d\n",strlen(a));
    printf("Compare = %d\n",strcmp(a,b));

    strcpy(b,a);
    printf("Copy = %s\n",b);

    strcat(a,b);
    printf("Concat = %s\n",a);

    printf("Reverse = %s\n",strrev(a));
    printf("Upper = %s\n",strupr(a));
    printf("Lower = %s\n",strlwr(a));

    p=strchr(a,'a');
    if(p)
        printf("Found = %s\n",p);
    else
        printf("Not Found");

    return 0;
}
